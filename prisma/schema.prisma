generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

enum UserRole {
  VISITOR
  AGENCY
  STAFF
  ADMIN
}

enum AgencyStatus {
  PENDING
  APPROVED
  NEEDS_CHANGES
  REJECTED
  SUSPENDED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PENDING_BANK_TRANSFER
  PARTIAL
  PAID
  FAILED
  REFUNDED
  EXPIRED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

enum AdPlacementType {
  FEATURED
  HOMEPAGE
  SEARCH
  CATEGORY_TOP
}

enum AdPlacementStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

enum EnquirySource {
  WEB
  CHAT
  WHATSAPP
  EMAIL
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

enum ConversationChannel {
  WEB
  WHATSAPP
  EMAIL
}

enum ConversationStatus {
  OPEN
  HANDED_OFF
  CLOSED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum FeatureFlagScope {
  GLOBAL
  AGENCY
}

enum HandoffStatus {
  OPEN
  ACCEPTED
  RESOLVED
  CANCELLED
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  passwordHash            String?
  emailVerified           DateTime?
  image                   String?
  role                    UserRole                 @default(VISITOR)
  disabled                Boolean                  @default(false)
  totpSecret              String?
  totpPendingSecret       String?
  totpEnabled             Boolean                  @default(false)
  totpVerifiedAt          DateTime?
  notificationPreferences Json?
  agencies                Agency[]
  conversations           Conversation[]
  aiCallLogs              AiCallLog[]
  auditLogs               AuditLog[]
  verificationTokens      EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  dataDeletionRequests    DataDeletionRequest[]
  agencyOnboardingDraft   AgencyOnboardingDraft?
  reportsCreated          Report[]                 @relation("ReportCreator")
  reportsResolved         Report[]                 @relation("ReportResolver")
  verifiedAgencies        Agency[]                 @relation("AgencyVerifier")
  manualPayments          Payment[]                @relation("PaymentReconciler")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([role])
}

model Agency {
  id                  String              @id @default(cuid())
  ownerId             String?
  owner               User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name                String
  slug                String              @unique
  description         String              @db.Text
  logoUrl             String?
  bannerUrl           String?
  licenseNumber       String?
  yearEstablished     Int?
  address             String
  city                String
  province            String
  phone               String
  whatsapp            String?
  email               String
  website             String?
  facebook            String?
  services            String[]
  nationalitiesServed String[]
  languages           String[]
  status              AgencyStatus        @default(PENDING)
  verifiedBadge       Boolean             @default(false)
  adminNote           String?             @db.Text
  profileCompleteness Int                 @default(0)
  onboardingStep      Int                 @default(1)
  submittedAt         DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?             @db.Text
  approvalChecklist   Json?
  verifiedAt          DateTime?
  verifiedById        String?
  verifiedBy          User?               @relation("AgencyVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  photos              AgencyPhoto[]
  subscriptions       Subscription[]
  adPlacements        AdPlacement[]
  enquiries           Enquiry[]
  reviews             Review[]
  analyticsEvents     AnalyticsEvent[]
  conversations       Conversation[]
  aiCallLogs          AiCallLog[]
  featureFlags        FeatureFlag[]
  aiSettings          AgencyAiSettings?
  knowledgeDocuments  KnowledgeDocument[]
  auditLogs           AuditLog[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@unique([ownerId])
  @@index([city, province, status])
  @@index([status, verifiedBadge])
}

model AgencyOnboardingDraft {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Json     @default("{}")
  currentStep Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AgencyPhoto {
  id        String   @id @default(cuid())
  agencyId  String
  agency    Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, sortOrder])
}

model Plan {
  id                     String         @id @default(cuid())
  name                   String         @unique
  priceMonthly           Decimal        @db.Decimal(10, 2)
  priceYearly            Decimal        @db.Decimal(10, 2)
  features               Json
  listingPriority        Int            @default(0)
  featuredSlots          Int            @default(0)
  maxPhotos              Int            @default(5)
  leadLimit              Int?
  isActive               Boolean        @default(true)
  subscriptions          Subscription[]
  scheduledSubscriptions Subscription[] @relation("ScheduledPlan")
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([isActive, listingPriority])
}

model Subscription {
  id                   String             @id @default(cuid())
  agencyId             String
  agency               Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  status               SubscriptionStatus @default(PENDING)
  startDate            DateTime
  endDate              DateTime?
  autoRenew            Boolean            @default(false)
  cancelAtPeriodEnd    Boolean            @default(false)
  graceEndsAt          DateTime?
  scheduledPlanId      String?
  downgradeEffectiveAt DateTime?
  scheduledPlan        Plan?              @relation("ScheduledPlan", fields: [scheduledPlanId], references: [id], onDelete: SetNull)
  billingPeriod        BillingPeriod      @default(MONTHLY)
  providerRef          String?
  payments             Payment[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([agencyId, status])
  @@index([planId, status])
  @@index([endDate])
}

model Payment {
  id                 String        @id @default(cuid())
  subscriptionId     String
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("PHP") @db.VarChar(3)
  status             PaymentStatus @default(PENDING)
  provider           String
  providerRef        String?
  checkoutRef        String?
  billingPeriod      BillingPeriod @default(MONTHLY)
  invoiceUrl         String?
  expiresAt          DateTime?
  prorated           Boolean       @default(false)
  bankReference      String?
  referenceCode      String?       @unique
  bankNotes          String?       @db.Text
  proofUrl           String?
  receivedAmount     Decimal?      @db.Decimal(10, 2)
  receivedAt         DateTime?
  reconciledById     String?
  reconciledBy       User?         @relation("PaymentReconciler", fields: [reconciledById], references: [id], onDelete: SetNull)
  reconciliationNote String?       @db.Text
  refundAmount       Decimal?      @db.Decimal(10, 2)
  refundReason       String?       @db.Text
  creditNoteNumber   String?
  invoiceNumber      String        @unique
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([subscriptionId, status])
  @@index([provider, providerRef])
}

model AdPlacement {
  id          String            @id @default(cuid())
  agencyId    String
  agency      Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  type        AdPlacementType
  startDate   DateTime
  endDate     DateTime
  status      AdPlacementStatus @default(SCHEDULED)
  impressions Int               @default(0)
  clicks      Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([agencyId, status, startDate, endDate])
  @@index([type, status])
}

model Enquiry {
  id                 String        @id @default(cuid())
  agencyId           String
  agency             Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  name               String
  email              String
  phone              String?
  message            String        @db.Text
  preferredStartDate DateTime?
  budget             Decimal?      @db.Decimal(10, 2)
  status             EnquiryStatus @default(NEW)
  consentGiven       Boolean       @default(false)
  privateNotes       String?       @db.Text
  anonymizedAt       DateTime?
  sourceIpHash       String?
  source             EnquirySource @default(WEB)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([agencyId, status, createdAt])
  @@index([email])
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Review {
  id              String       @id @default(cuid())
  agencyId        String
  agency          Agency       @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  authorName      String
  reviewerEmail   String?
  authorIpHash    String?
  rating          Int
  title           String
  body            String       @db.Text
  status          ReviewStatus @default(PENDING)
  agencyReply     String?      @db.Text
  agencyRepliedAt DateTime?
  reportedAt      DateTime?
  reportReason    String?      @db.Text
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([agencyId, status, createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, type, createdAt])
  @@index([type, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agencyId  String?
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([agencyId, createdAt])
  @@index([entity, entityId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String?
  reporter       User?        @relation("ReportCreator", fields: [reporterId], references: [id], onDelete: SetNull)
  agencyId       String?
  reviewId       String?
  targetType     String
  targetId       String
  reason         String       @db.Text
  status         ReportStatus @default(OPEN)
  resolutionNote String?      @db.Text
  resolvedById   String?
  resolvedBy     User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([agencyId, status])
}

model BlockList {
  id        String   @id @default(cuid())
  type      String
  valueHash String   @unique
  reason    String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, active])
}

model AdminSetting {
  key         String   @id
  value       Json
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([updatedById])
}

model Conversation {
  id        String              @id @default(cuid())
  channel   ConversationChannel
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  agencyId  String?
  agency    Agency?             @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  status    ConversationStatus  @default(OPEN)
  messages  Message[]
  handoffs  HandoffRequest[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([channel, status, createdAt])
  @@index([userId, status])
  @@index([agencyId, status])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  tokens         Int?
  feedback       AiFeedback?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, createdAt])
}

model AiCallLog {
  id            String   @id @default(cuid())
  feature       String
  model         String
  promptVersion String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  latencyMs     Int      @default(0)
  costEstimate  Decimal? @db.Decimal(12, 6)
  status        String
  errorMessage  String?  @db.Text
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agencyId      String?
  agency        Agency?  @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([feature, status, createdAt])
  @@index([userId, createdAt])
  @@index([agencyId, createdAt])
}

model FeatureFlag {
  id        String           @id @default(cuid())
  key       String
  enabled   Boolean          @default(false)
  scope     FeatureFlagScope @default(GLOBAL)
  agencyId  String?
  agency    Agency?          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([key, scope, agencyId])
  @@index([key, scope, enabled])
  @@index([agencyId])
}

model AgencyAiSettings {
  id               String   @id @default(cuid())
  agencyId         String   @unique
  agency           Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  autoReplyEnabled Boolean  @default(false)
  replyTone        String   @default("professional")
  businessHours    Json?
  languages        String[]
  escalationEmail  String?
  knowledgeBase    String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([autoReplyEnabled])
}

model KnowledgeDocument {
  id        String                       @id @default(cuid())
  agencyId  String?
  agency    Agency?                      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  title     String
  content   String                       @db.Text
  embedding Unsupported("vector(1536)")?
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([agencyId])
}

model AiFeedback {
  id        String   @id @default(cuid())
  messageId String   @unique
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rating, createdAt])
}

model HandoffRequest {
  id             String        @id @default(cuid())
  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reason         String        @db.Text
  status         HandoffStatus @default(OPEN)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([conversationId, status])
  @@index([status, createdAt])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  processedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([provider, eventId])
  @@index([eventType, processedAt])
}

model SubscriptionNotice {
  id             String   @id @default(cuid())
  subscriptionId String
  noticeType     String
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([subscriptionId, noticeType])
  @@index([sentAt])
}

model InvoiceSequence {
  year      Int      @id
  lastValue Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DataDeletionRequest {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String
  reason    String?  @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
