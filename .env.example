# Single environment file template. Copy to `.env` and fill in.
# There is no .env.test / .env.staging — `npm run test:display` runs against the
# in-memory Prisma mock and never needs a database.
#
# Cloudflare Workers: the process environment is NOT read from this file at
# runtime. Non-secret values are mirrored in wrangler.jsonc `vars`; upload the
# secret ones with:
#   npx wrangler secret put AUTH_SECRET
#   npx wrangler secret put NEXTAUTH_SECRET
#   npx wrangler secret put TOTP_ENCRYPTION_KEY
#   npx wrangler secret put CRON_SECRET
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   npx wrangler secret put DATABASE_URL

DATABASE_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"
POSTGRES_PASSWORD=""
SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_MEDIA_BUCKET="findmaids-media"
SUPABASE_PRIVATE_BUCKET="findmaids-private"
AUTH_SECRET="replace-with-a-long-random-value"
NEXTAUTH_SECRET="replace-with-the-same-long-random-value"
# Required by NextAuth when it runs on Cloudflare Workers.
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"
TOTP_ENCRYPTION_KEY="base64-encode-exactly-32-random-bytes"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED="false"
EMAIL_FROM="FindMaids <onboarding@resend.dev>"
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
AI_PROVIDER="mock"
AI_MODEL="claude-3-5-sonnet-latest"
AI_API_KEY=""
AI_MAX_TOKENS="1024"
AI_RATE_LIMIT="30"
AI_WEBHOOK_URL=""
AI_WEBHOOK_SECRET=""
AI_EMBEDDINGS_WEBHOOK_URL=""
AI_OUTBOUND_WEBHOOK_URL=""
AI_OUTBOUND_WEBHOOK_SECRET=""
AI_MONTHLY_BUDGET_SGD="1000"
AI_DEFAULT_AGENCY_BUDGET_SGD="50"
AI_SGD_PER_USD="1.35"
AI_INPUT_USD_PER_MILLION="3"
AI_OUTPUT_USD_PER_MILLION="15"
AI_TEMPERATURE="0.2"
AI_TIMEOUT_MS="15000"
AI_EMBEDDING_DIMENSIONS="1536"
REDIS_URL=""
WHATSAPP_WEBHOOK_SECRET=""
EMAIL_WEBHOOK_SECRET=""
RESEND_API_KEY=""
BUSINESS_COUNTRY="SG"
MANUAL_BANK_TRANSFER_ENABLED="false"
CRON_SECRET="replace-with-a-random-cron-secret"
DATA_REQUEST_EMAIL="support@example.test"
DATA_RETENTION_DAYS="365"
LEAD_CAP_MODE="DELIVER_ALL"
FOUNDING_PERIOD_EMAILS_ENABLED="false"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_MAINTENANCE_MESSAGE=""
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.05"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.05"
LOG_LEVEL="info"
