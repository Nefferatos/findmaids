# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-staging/
/out/
/.open-next/
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (there is a single .env; .env.example is the template)
.env
.env.*
!.env.example
!.dev.vars.example

# TypeScript build cache
*.tsbuildinfo

# display-only E2E artefacts (in-memory Prisma mock store)
/.next-display/
/display-e2e.log
/display-e2e.err.log
/dev-smoke.log
/dev-smoke.err.log
/test-results/

# local run artefacts
/dev.out
/dev.err
/build_log.txt
/build_output.txt
/build-check.log
/npm-install.log
/cf-fix-*.log
/cf-fix-*.err.log
/schema.diff
/schema.diff2
/.tsupgrader/
.env.deploybak
