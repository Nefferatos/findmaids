{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "findmaids",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-25",
  "compatibility_flags": ["nodejs_compat"],
  // The bundle carries Prisma's 2.3 MB engine wasm, so keep the script small:
  // minify, and do not upload the ~34 MB source map (Cloudflare rejects scripts
  // over 63.9 MiB uncompressed, [code: 10027]).
  "minify": true,
  "upload_source_maps": false,
  // Next.js + Prisma cannot fit the Free plan's 10 ms CPU budget: auth routes die
  // with `outcome: "exceededCpu"` and the browser sees 500s on
  // /api/auth/callback/credentials. On a paid plan, uncomment this (a paid
  // account allows up to 30 s) — the Free plan rejects it with code 100328.
  // "limits": {
  //   "cpu_ms": 30000
  // },
  // Prisma's generated client is compiled into the Worker as a `.wasm` module
  // (see prisma/schema.prisma, `runtime = "workerd"`); Cloudflare needs the
  // module type declared. `fallthrough` keeps other rules matching.
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Pooled Postgres connection for the Worker runtime; `lib/prisma.ts` prefers
  // HYPERDRIVE.connectionString. Created for this account with
  //   wrangler hyperdrive create findmaids-supabase --connection-string <session pooler> --caching-disabled
  // (caching disabled so a maid edit/publish is visible on the next request).
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "7b18607838664896bddab1469031d074",
      // Only used by `wrangler dev` / the platform proxy. Deliberately a
      // placeholder: local development runs through `npm run dev` with DATABASE_URL
      // from the git-ignored .env, and the deployed Worker uses the remote config.
      "localConnectionString": "postgres://localhost:5432/postgres"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "findmaids"
    }
  ],
  // Non-secret runtime configuration (mirrors .env). Secrets are uploaded with
  // `wrangler secret put` — see SETUP notes in .env.example.
  "vars": {
    "APP_ENV": "production",
    "NODE_ENV": "production",
    // Belt and braces with APP_ENV: sample/demo agencies and maids are never
    // rendered by a deployed Worker (see lib/sample-data.ts). Localhost keeps
    // showing them because `npm run dev` has no APP_ENV marker.
    "SHOW_SAMPLE_DATA": "false",
    "DATABASE_SCHEMA": "public",
    // Public origin of this Worker (workers.dev host for the current account).
    // Change both to the custom domain once one is attached.
    "NEXT_PUBLIC_SITE_URL": "https://findmaids.wow-aisolution.workers.dev",
    "NEXTAUTH_URL": "https://findmaids.wow-aisolution.workers.dev",
    "SUPABASE_URL": "https://tajpujqabclbxoggkxse.supabase.co",
    "SUPABASE_MEDIA_BUCKET": "findmaids-media",
    "SUPABASE_PRIVATE_BUCKET": "findmaids-private",
    "AUTH_TRUST_HOST": "true",
    "NEXT_PUBLIC_GOOGLE_AUTH_ENABLED": "false",
    "BUSINESS_COUNTRY": "SG",
    "MANUAL_BANK_TRANSFER_ENABLED": "false",
    "LEAD_CAP_MODE": "DELIVER_ALL",
    "DATA_RETENTION_DAYS": "365",
    "FOUNDING_PERIOD_EMAILS_ENABLED": "false",
    "AI_PROVIDER": "mock",
    "AI_MODEL": "mock",
    "PAYMENT_PROVIDER": "mock",
    "EMAIL_DELIVERY_DISABLED": "true",
    "LOG_LEVEL": "info"
  }
}
