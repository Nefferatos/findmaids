{
  "name": "findmaids",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:demo": "next build --no-typecheck",
    "start": "next start",
    "preview:cf": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && npx wrangler deploy --name findmaids",
    "deploy:cf:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-cloudflare-windows.ps1",
    "upload:cf": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:display": "playwright test -c playwright.display.config.ts",
    "evals": "tsx tests/ai-evals/run.ts",
    "jobs:worker": "tsx lib/jobs/worker.ts",
    "seed:production-catalog": "tsx scripts/seed-production-catalog.ts",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "seed": "tsx prisma/seed.ts",
    "accounts:test": "tsx scripts/create-test-accounts.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@marsidev/react-turnstile": "^1.6.3",
    "@prisma/adapter-pg": "6.19.0",
    "@prisma/client": "6.19.0",
    "@sentry/nextjs": "^10.38.20",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "next-mdx-remote": "^6.0.0",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.4.5"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "^26",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.148.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "effect": "3.22.3",
    "magic-string": "0.30.21"
  }
}
